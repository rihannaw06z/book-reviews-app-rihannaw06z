<div>
 <% if authenticated?%>
  <h1 class="text-3xl font-bold mt-4 ml-2">Welcome back, <%= current_user.username %>!</h1>
 <% else %>
  <h1 class="text-3xl font-bold mt-4 ml-2">Books Stats</h1>
 <% end %>
</div>

<div class="container grid grid-cols-2 gap-6 mt-6">
  <div>
  
   <h2 class="text-2xl font-semibold mt-6 ml-4">Popular Reviews</h2>
    <ul class="container grid grid-rows-1 gap-6 mt-4">
      <% @most_liked_reviews.each do |review| %>
        <li class="p-4 border border-purple-900 bg-purple-900/20 text-white rounded w-3/4">
          <% details = book_details(review.google_book_id) %>
          <h3 class="text-lg font-bold"><%= details["volumeInfo"]["title"] || "Title unavailable" %></h3>
          <p class="font-semibold">By <%= details["volumeInfo"]["authors"]&.join(", ") || "Unknown Author" %></p>
          <p><%= review.comment %></p>
          <p class="mt-2 text-sm text-white">❤️ Likes (<%= review.likes_count %>)</p>
        </li>
      <% end %>
    </ul>
  </div>
  <div>
    <h2 class="text-2xl font-semibold mt-6">Top Rated Books</h2>

    <div class="container grid grid-rows-1 gap-6 mt-4 mr-2">
      <% @book_details.each do |book| %>
        <div class="p-4 border border-purple-900 bg-purple-900/20 text-white rounded w-3/4">
          <h2 class="text-lg font-bold"><%= book[:title] %></h2>
          <p class="font-semibold">By <%= book[:authors] %></p>
          <p>Average Rating: <%= book[:average_rating].round(1) %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>