<h1 class="text-2xl font-bold mt-4">Reviews for <strong><em><%= @book_details["volumeInfo"]["title"]%></em></strong></h1>
<% if @reviews.any? %>
  <ul class="list-disc list-inside mt-4 space-y-4 outline outline-1 outline-gray-600 p-4 rounded-lg">
    <% @reviews.each do |review| %>
      <li>
        <strong class="text-lg font-bold"><em><%= review.user.username %></em></strong><br>
        <strong class="text-md font-bold"><%= review.title %></strong><br>
        <strong class="text-md font-semibold">Rating:</strong> <%= review.rating %>/5<br>
        <%= review.comment %>
        <%= link_to "View", book_review_path(params[:book_id], review), class: "btn btn-outline-primary underline text-blue-500 hover:text-blue-700" %>
        <div class="likes">
          <% if authenticated? %>
            <% existing_like = review.likes.find_by(user: Current.user) %>
            <% if existing_like %>
            <!-- unlike button sends DELETE request to remove the existing like -->
             <%= button_to book_review_like_path(params[:book_id], review, existing_like), method: :delete, class: "btn btn-outline-danger btn-outline-red bg-transparent" do %>
             ♥️ Unlike (<%= review.likes.count%>)
             <% end %>
            <% else %>
            <!--like button sends POST request to create a new like -->
             <%= button_to book_review_likes_path(params[:book_id], review), method: :post, class: "btn btn-outline-success bg-transparent" do %>
             🤍 Like (<%= review.likes.count %>)
             <% end %>
            <% end %>
          <% else %>
          <!-- Logged out view -->
          <span>🤍 Likes: <%= review.likes.count %><%= "like".pluralize(review.likes.count) %>
          </span>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No reviews yet.</p>
<% end %>

<%= link_to "Write a Review", new_book_review_path(params[:book_id]), class: "btn btn-primary underline text-blue-500 hover:text-blue-700" %>
<%= link_to "Back to Book Details", book_path(params[:book_id]), class: "btn btn-secondary underline text-gray-500 hover:text-gray-700" %>
