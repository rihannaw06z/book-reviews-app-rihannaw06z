<% content_for :title, "Editing review" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl text-orange-800 mt-4">Editing <%= @review.title %></h1>

  <%= render "form", review: @review %>

  <%= link_to "Show this review", book_review_path(@review.google_book_id, @review), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to Book", book_path(params[:book_id]), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
