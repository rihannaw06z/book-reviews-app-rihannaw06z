<div class="max-w-md mx-auto mt-10 p-6 border border-purple-800 bg-purple-600/40 text-white rounded-md shadow-md">
  <h1 class="text-2xl font-bold mb-6 text-center">Create Your Account</h1>

  <%= form_with model: @user, url: users_path, class: "space-y-4" do |form| %>
    <% if @user.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div> 
    <% end %>

    <div>
      <%= form.label :username, class: "block text-sm font-lg font-bold text-gray-700 mb-1" %>
      <%= form.text_field :username, class: "w-full px-3 py-2 rounded-md outline outline-purple-800 focus:outline focus:ring-2 focus:ring-purple-400", placeholder: "Enter your username", required: true %>
    </div>

    <div>
      <%= form.label :email_address, class: "block text-sm font-lg font-bold text-gray-700 mb-1" %>
      <%= form.email_field :email_address, class: "w-full px-3 py-2 rounded-md outline outline-purple-800 focus:outline focus:ring-2 focus:ring-purple-400", placeholder: "you@example.com", required: true %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-lg font-bold text-gray-700 mb-1" %>
      <%= form.password_field :password, class: "w-full px-3 py-2 rounded-md outline outline-purple-800 focus:outline focus:ring-2 focus:ring-purple-400", placeholder: "Choose a strong password", required: true %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-lg font-bold text-gray-700 mb-1" %>
      <%= form.password_field :password_confirmation, class: "w-full px-3 py-2 rounded-md outline outline-purple-800 focus:outline focus:ring-2 focus:ring-purple-400", placeholder: "Type your password again", required: true %>
    </div>

    <%= form.submit "Create Account", class: "w-full py-2 px-4 rounded-md hover:bg-purple-700 transition duration-200 font-medium" %>
  <% end %>

  <div class="mt-4 text-center text-sm text-gray-100">
    Already have an account? 
    <%= link_to "Log in", new_session_path, class: "text-purple-900 hover:underline" %>
  </div>
</div>