<% if flash[:alert] %>
  <div class="alert alert-warning"><%= flash[:alert] %></div>
<% end %>

<h1 class="text-center text-3xl font-bold mt-4 mb-4">Search by Author</h1>

<div class= "flex justify-center p-1 mb-6 w-full"">
  <%= form_with url: books_by_index_path, method: :get, class: "w-1/2 p-3 bg-white/60 rounded-full", local: true do |form| %>
    <%= form.text_field :author, placeholder: "Enter author name..."%>
    <%= form.submit "Search", class: "text-sm bg-orange-900 hover:bg-gray-800 text-white font-bold py-1 px-2 rounded ml-110" %>
  <% end %>
</div>

<h3 class="text-center text-xl font-bold mb-4">Books by <%= params[:author] %></h3>

<div class="grid grid-rows-3 gap-4">
  <% if @books_by_author.any? %>
    <% @books_by_author.each do |book| %>
      <div class="text-md text-white my-4 p-3 border border-purple-900 rounded-md w-3/4 mx-auto bg-purple-900">
        <strong class="text-lg font-bold"><%= book["volumeInfo"]["title"] %></strong><br>
        <em>by <%= book["volumeInfo"]["authors"]&.join(", ") %></em><br>
        <% if book["volumeInfo"]["imageLinks"] %>
          <img src="<%= book["volumeInfo"]["imageLinks"]["thumbnail"] %>" alt="<%= book["volumeInfo"]["title"] %> cover">
        <% end %>
        <p><%= book["volumeInfo"]["description"]&.truncate(150) %></p>

        <%= link_to "View Details", book_path(book["id"]), class: "inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        </div>
    <% end %>
</div>
<% else %>
  <p>No books found for this author.</p>
<% end %>

