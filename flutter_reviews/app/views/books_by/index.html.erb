<% if flash[:alert] %>
  <div class="alert alert-warning"><%= flash[:alert] %></div>
<% end %>

<h1 class="text-lg font-bold mb-4">Search by Author</h1>

<div class= "outline outline-1 outline-gray-600 p-1 mb-6 w-186">
  <%= form_with url: books_by_index_path, method: :get, local: true do |form| %>
    <%= form.text_field :author, placeholder: "Enter author name..."%>
    <%= form.submit "Search", class: "bg-orange-900 hover:bg-gray-800 text-white font-bold py-2 px-4 rounded ml-110" %>
  <% end %>
</div>

<h3 class="text-md font-bold mb-4">Books by <%= params[:author] %></h3>

<% if @books_by_author.any? %>
  <% @books_by_author.each do |book| %>
    <div class="my-4 p-3 border rounded">
      <strong><%= book["volumeInfo"]["title"] %></strong><br>
      <em>by <%= book["volumeInfo"]["authors"]&.join(", ") %></em><br>
      <% if book["volumeInfo"]["imageLinks"] %>
        <img src="<%= book["volumeInfo"]["imageLinks"]["thumbnail"] %>" alt="<%= book["volumeInfo"]["title"] %> cover">
      <% end %>
      <p><%= book["volumeInfo"]["description"]&.truncate(150) %></p>

      <%= link_to "View Details", book_path(book["id"]), class: "inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
  <% end %>
<% else %>
  <p>No books found for this author.</p>
<% end %>

