<% if flash[:alert] %>
  <div class="alert alert-warning"><%= flash[:alert] %></div>
<% end %>

  <h1 class="text-lg font-bold mb-4">Search for a Book</h1>
  <div class= "outline outline-1 outline-gray-600 p-1 mb-6 w-186">
    <%= form_with url: search_path, method: :get, local: true do |form| %>
      <%= form.text_field :query, placeholder: "Enter book title...", value: params[:query] %>
      <%= form.submit "Search", class: "bg-orange-900 hover:bg-gray-800 text-white font-bold py-2 px-4 rounded ml-110" %>
    <% end %>
  </div>

  <h3 class="text-md font-bold mb-4">Search Results</h3>

  <% if @google_data.any? %>
    <% @google_data.each do |book| %>
      <% info = book["volumeInfo"] %>
      <div class="text-md book my-4 p-3 border rounded">
        <h2><%= info["title"] %></h2>
        <p><%= info["authors"]&.join(", ") %></p>
        <% if info["imageLinks"] %>
          <img src="<%= info["imageLinks"]["thumbnail"] %>" alt="<%= info["title"] %> cover">
        <% end %>
        <%= link_to "View Details", book_path(book["id"]), class: "inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-1 px-2 mt-2 rounded" %>
      </div>
    <% end %>
  <% else %>
    <p>No results found. It might be our fault! Please try again.</p>
  <% end %>
