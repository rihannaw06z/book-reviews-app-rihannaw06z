<% if flash[:alert] %>
  <div class="alert alert-warning"><%= flash[:alert] %></div>
<% end %>

  <h1 class="text-center text-3xl font-bold mt-4 mb-4">Search for a Book</h1>
  <div class= "flex justify-center p-1 mb-6 w-full">
    <%= form_with url: search_path, method: :get, class: "w-1/2 p-3 bg-white/60 rounded-full", local: true do |form| %>
      <%= form.text_field :query, placeholder: "Enter book title...", value: params[:query] %>
      <%= form.submit "Search", class: "text-sm bg-orange-900 hover:bg-gray-800 text-white font-bold py-1 px-2 rounded ml-110" %>
    <% end %>
  </div>

  <h3 class="text-center text-xl font-bold mb-4">Search Results</h3>

  <div  class="grid cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% if @google_data.any? %>
      <% @google_data.each do |book| %>
        <% info = book["volumeInfo"] %>
        <div class="book text-md text-white my-4 p-3 border border-purple-900 rounded-md w-3/4 mx-auto bg-purple-900">
          <h2 class="text-lg font-bold"><%= info["title"] %></h2>
          <p><%= info["authors"]&.join(", ") %></p>
          <% if info["imageLinks"] %>
            <img src="<%= info["imageLinks"]["thumbnail"] %>" alt="<%= info["title"] %> cover">
          <% end %>

          <%= link_to "View Details", book_path(book["id"]), class: "inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-1 px-2 mt-2 rounded" %>
        </div>
      <% end %>
  </div>
      <% else %>
        <p class="text-center">No results found. It might be our fault! Please try again.</p>
      <% end %>
